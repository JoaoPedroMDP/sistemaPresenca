FROM ghcr.io/astral-sh/uv:alpine
WORKDIR /app

RUN apk add --no-cache tzdata

# Produção: só dependências de runtime. O compose de teste passa
# INSTALL_DEV=true para trazer pytest.
ARG INSTALL_DEV=false
COPY pyproject.toml uv.lock /app/
RUN if [ "$INSTALL_DEV" = "true" ]; then uv sync --frozen; else uv sync --frozen --no-dev; fi

COPY . /app

ENV VIRTUAL_ENV=/app/.venv
ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8000
ENTRYPOINT ["/app/back_entrypoint.sh"]
