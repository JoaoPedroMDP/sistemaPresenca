# Copie para front/.env.local (ignorado pelo git) e ajuste.
# Lido pelo vite.config.ts via loadEnv(mode, cwd, 'VITE_').
# `vite dev` roda em mode=development; allowedHosts só é aplicado nesse mode.

# Hosts extras aceitos pelo dev server (header Host), separados por vírgula.
# Necessário para acessar de outro dispositivo na rede via hostname.local ou IP.
VITE_ALLOWED_HOSTS=hostname.local
